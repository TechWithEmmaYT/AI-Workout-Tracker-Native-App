{
  "expo": {
    "name": "ai-workout-tracker",
    "slug": "ai-workout-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aiworkouttracker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2563EB",
          "image": "./assets/images/splash-logo-white.png",
          "imageWidth": 280,
          "resizeMode": "contain"
          //  "dark": {
          //   "backgroundColor": "#1E3A8A",
          //   "image": "./assets/images/splash-logo-dark.png"
          // }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MyWorkout Tracker to access your photos so you can choose a workout cover.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
